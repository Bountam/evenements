<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName Condition="'$(RuntimeIdentifier)' != 'linux-x64'">InsertechEvenements</AssemblyName>
    <AssemblyName Condition="'$(RuntimeIdentifier)' == 'linux-x64'">InsertechEvenements-linux-x64</AssemblyName>
    <RootNamespace>InsertechEvenements</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Bibliothèque native SQLite gardée dans l'exécutable unique, extraite au lancement -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' != 'linux-x64'">..\app.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' != 'linux-x64'">..\app.manifest</ApplicationManifest>
    <AssemblyTitle>Insertech Événements</AssemblyTitle>
    <Company>Insertech Angus</Company>
    <Product>Insertech Événements</Product>
    <Copyright>Copyright © 2026 Insertech</Copyright>
    <Version>1.2.6</Version>
    <FileVersion>1.2.6.0</FileVersion>
    <AssemblyVersion>1.2.6.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\dist\index.html" LogicalName="app_index.html" />
    <EmbeddedResource Include="..\logo.png" LogicalName="app_logo.png" />
  </ItemGroup>
</Project>
