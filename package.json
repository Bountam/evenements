{
  "name": "insertech-tableau-evenements",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && node scripts/check-design-tokens.js && node scripts/sync-version.js --check",
    "version": "node scripts/sync-version.js && git add launcher/InsertechLauncher.csproj app.manifest android/app/build.gradle",
    "build:exe": "npm run build && dotnet publish launcher -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true -o ./dist-win && node scripts/copy-artifact.js win",
    "build:linux": "npm run build && dotnet publish launcher -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true -o ./dist-linux && node scripts/copy-artifact.js linux",
    "build:mobile": "npm run build && node scripts/build-mobile-package.js",
    "test:ui": "playwright test",
    "build:all": "npm run build:exe && npm run build:linux && npm run build:mobile"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "dexie": "^4.4.7",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.4",
    "ws": "^8.22.1"
  }
}
